# =============================================================================
# DocuMind AI — Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values.
# Lines starting with # are comments and are ignored.
# DO NOT commit .env to version control.
#
# Quick start (minimum required):
#   1. Copy to .env
#   2. Set HUGGINGFACE_API_KEY  -OR-  install Ollama (local, free)
#   3. All other settings have sensible defaults
# =============================================================================


# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
APP_ENV=development          # development | testing | production
APP_DEBUG=False              # True only for development

# -----------------------------------------------------------------------------
# Server
# -----------------------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
WORKERS=1                    # Increase to CPU count in production

# CORS — comma-separated origins, or * for development only
# Example: http://localhost:3000,https://app.example.com
CORS_ORIGINS=*

# -----------------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------------
LOG_LEVEL=INFO               # DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_FORMAT=human             # human (coloured) | json (structured, for prod)
LOG_FILE=                    # Optional: logs/app.log (enables rotating file log)

# -----------------------------------------------------------------------------
# Embedding Model
# -----------------------------------------------------------------------------
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384
USE_GPU=False                # Set True if CUDA is available

# -----------------------------------------------------------------------------
# Document Processing
# -----------------------------------------------------------------------------
CHUNK_SIZE=1000              # Characters per chunk (100–5000)
CHUNK_OVERLAP=200            # Overlap between chunks (0–500)
MAX_LENGTH=512               # Max token length for embeddings
MIN_CHUNK_SIZE=200           # Minimum chunk size (smaller chunks discarded)
MAX_SINGLE_CHUNK_SIZE=10000  # Whole-document threshold
MAX_UPLOAD_BYTES=20971520    # Max upload file size (default 20 MB)

# -----------------------------------------------------------------------------
# Vector Database
# -----------------------------------------------------------------------------
VECTOR_DB_TYPE=faiss         # faiss | keyword
FAISS_INDEX_TYPE=Flat        # Flat | IVF | HNSW

# -----------------------------------------------------------------------------
# Retrieval
# -----------------------------------------------------------------------------
TOP_K=5                      # Number of chunks to retrieve per query
SEARCH_TYPE=hybrid           # semantic | keyword | hybrid
SEMANTIC_SEARCH_WEIGHT=0.7   # Weight for semantic (FAISS) scores
KEYWORD_SEARCH_WEIGHT=0.3    # Weight for keyword (BM25) scores

# -----------------------------------------------------------------------------
# LLM — OpenAI (optional)
# -----------------------------------------------------------------------------
LLM_MODEL=gpt-3.5-turbo
OPENAI_API_KEY=              # sk-... from https://platform.openai.com/api-keys
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=512

# -----------------------------------------------------------------------------
# LLM — HuggingFace Inference API (free fallback)
# Get token: https://huggingface.co/settings/tokens
# -----------------------------------------------------------------------------
HUGGINGFACE_API_KEY=         # hf_...
HUGGINGFACE_MODEL=mistralai/Mistral-7B-Instruct-v0.2

# -----------------------------------------------------------------------------
# LLM — Ollama (local, free, no internet needed — preferred)
# Install: https://ollama.ai  then: ollama pull phi
# No config needed — detected automatically at http://localhost:11434
# -----------------------------------------------------------------------------

# -----------------------------------------------------------------------------
# OCR
# -----------------------------------------------------------------------------
OCR_ENGINE=tesseract         # tesseract | easyocr
# Windows example: C:\\Program Files\\Tesseract-OCR\\tesseract.exe
# Linux default:   /usr/bin/tesseract
TESSERACT_CMD=               # Leave blank to use PATH auto-detection
OCR_LANGUAGE=eng             # Tesseract language code(s), e.g. eng+hin

# -----------------------------------------------------------------------------
# Firebase (optional — enables cloud persistence and status tracking)
# Setup guide: see FIREBASE_SETUP_GUIDE.md
# -----------------------------------------------------------------------------
FIREBASE_PROJECT_ID=                        # your-project-id
# Path to service account JSON key (download from Firebase Console)
FIREBASE_CREDENTIALS_PATH=./firebase-credentials.json
FIREBASE_PROJECT_ID=your-project-id

# Cloudinary file storage (Firebase Auth/Firestore remain enabled)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# -----------------------------------------------------------------------------
# Neo4j (optional — enables persistent KG storage)
# Default: in-memory KG stored in kg_store.json
# -----------------------------------------------------------------------------
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=                             # Required if using Neo4j
NEO4J_DATABASE=neo4j

# -----------------------------------------------------------------------------
# Knowledge Graph
# -----------------------------------------------------------------------------
# Path where in-memory KG is persisted to disk (JSON)
KG_STORE_PATH=kg_store.json

# -----------------------------------------------------------------------------
# Confidence Thresholds
# -----------------------------------------------------------------------------
CONFIDENCE_THRESHOLD_LOW=0.70
CONFIDENCE_THRESHOLD_HIGH=0.90

# -----------------------------------------------------------------------------
# Authentication & Security
# -----------------------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=dev-jwt-secret-change-in-production-please
JWT_ISSUER=documind-ai
ACCESS_TOKEN_TTL_MINUTES=30
REFRESH_TOKEN_TTL_DAYS=7

# Aadhaar HMAC key — 32-byte random secret
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
AADHAAR_HMAC_KEY=dev-aadhaar-hmac-key-change-in-prod

# OTP settings
OTP_TTL_SECONDS=300          # 5 minutes
OTP_MAX_ATTEMPTS=5           # lock OTP after 5 wrong attempts

# Account lockout
LOCKOUT_THRESHOLD=5          # failed attempts before lockout
LOCKOUT_DURATION_MINUTES=15  # lockout duration

# Session settings
SESSION_TTL_HOURS=8          # session expires after 8 hours

# Auth store path (JSON persistence for sessions/users/devices)
AUTH_STORE_PATH=auth_store.json

# MFA app name (shown in authenticator apps)
MFA_APP_NAME=DocuMind AI

# -----------------------------------------------------------------------------
# Railway / Cloud deployment (auto-set by Railway — do not set manually)
# -----------------------------------------------------------------------------
# PORT=                      # Railway injects this; overrides API_PORT
# RAILWAY_ENVIRONMENT=       # production | staging
