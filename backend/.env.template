# Environment Configuration Template
# Copy this file to .env and fill in your actual values
# NEVER commit .env to version control

# ===== Embedding Model Settings =====
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384
USE_GPU=False

# ===== Document Processing Settings =====
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
MAX_LENGTH=512
MIN_CHUNK_SIZE=200
MAX_SINGLE_CHUNK_SIZE=10000

# ===== Vector Database Settings =====
VECTOR_DB_TYPE=faiss
FAISS_INDEX_TYPE=Flat
MONGODB_URI=mongodb://localhost:27017/
DB_NAME=rag_db
COLLECTION_NAME=documents

# ===== Retrieval Settings =====
TOP_K=5
SEARCH_TYPE=hybrid
SEMANTIC_SEARCH_WEIGHT=0.7
KEYWORD_SEARCH_WEIGHT=0.3

# ===== LLM Settings =====
LLM_MODEL=gpt-3.5-turbo
OPENAI_API_KEY=your-openai-api-key-here
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=512

# ===== HuggingFace API Settings =====
HUGGINGFACE_API_KEY=your-huggingface-api-key-here
HUGGINGFACE_MODEL=mistralai/Mistral-7B-Instruct-v0.2

# ===== Local LLM Settings =====
LOCAL_LLM_MODEL=google/flan-t5-base
USE_LOCAL_LLM=False

# ===== API Settings =====
API_HOST=0.0.0.0
API_PORT=8000

# ===== Logging Settings =====
LOG_LEVEL=INFO
LOG_FORMAT=%(asctime)s - %(name)s - %(levelname)s - %(message)s

# ===== Firebase Settings (P16) =====
FIREBASE_PROJECT_ID=documindai-in
FIREBASE_CREDENTIALS_PATH=./firebase-credentials.json

# ===== Cloudinary File Storage =====
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ===== Neo4j Knowledge Graph Settings (P9) =====
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your-neo4j-password
NEO4J_DATABASE=neo4j

# ===== OCR Settings (P1) =====
OCR_ENGINE=tesseract  # Options: tesseract, easyocr
TESSERACT_CMD=/usr/bin/tesseract  # Path to tesseract binary
OCR_LANGUAGE=eng

# ===== Confidence Thresholds (P12) =====
CONFIDENCE_THRESHOLD_LOW=0.70
CONFIDENCE_THRESHOLD_HIGH=0.90

# ===== Railway Deployment (P16) =====
RAILWAY_ENVIRONMENT=production
PORT=8000
