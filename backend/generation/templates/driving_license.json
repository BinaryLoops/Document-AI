{
  "document_type": "driving_license",
  "display_name": "Driving Licence",
  "issuing_authority": "Regional Transport Office",
  "validity_years": 20,
  "sections": [
    {
      "name": "Personal Information",
      "fields": [
        { "name": "full_name",        "label": "Full Name",            "type": "text",  "required": true,  "max_length": 100 },
        { "name": "date_of_birth",    "label": "Date of Birth",        "type": "date",  "required": true },
        { "name": "blood_group",      "label": "Blood Group",          "type": "enum",  "required": true,  "options": ["A+","A-","B+","B-","O+","O-","AB+","AB-"] },
        { "name": "gender",           "label": "Gender",               "type": "enum",  "required": true,  "options": ["M", "F", "X"] },
        { "name": "address",          "label": "Permanent Address",    "type": "textarea", "required": true },
        { "name": "pincode",          "label": "PIN Code",             "type": "text",  "required": true,  "pattern": "^[0-9]{6}$" }
      ]
    },
    {
      "name": "Licence Details",
      "fields": [
        { "name": "vehicle_classes",  "label": "Vehicle Class(es)",    "type": "text",  "required": true,  "max_length": 100,
          "help": "e.g. LMV, MCWG, TRANS — comma-separated" },
        { "name": "rto_code",         "label": "RTO Code",             "type": "text",  "required": true,  "pattern": "^[A-Z]{2}[0-9]{2}$" },
        { "name": "state",            "label": "State",                "type": "text",  "required": true,  "max_length": 50 }
      ]
    },
    {
      "name": "Identity References",
      "fields": [
        { "name": "aadhaar_number",   "label": "Aadhaar Number",       "type": "text",  "required": true,  "pattern": "^[0-9]{12}$" },
        { "name": "father_or_spouse", "label": "Father / Spouse Name", "type": "text",  "required": true,  "max_length": 100 }
      ]
    }
  ],
  "supporting_docs_required": ["Identity Proof", "Address Proof", "Age Proof"],
  "mrz_enabled": false,
  "biometric_enabled": false
}
